if(NOT DEFINED INPUT OR NOT DEFINED OUTPUT OR NOT DEFINED VARIABLE)
    message(FATAL_ERROR "INPUT, OUTPUT, and VARIABLE are required to generate a SPIR-V header.")
endif()

file(READ "${INPUT}" SPIRV_HEX HEX)
string(LENGTH "${SPIRV_HEX}" SPIRV_HEX_LENGTH)
math(EXPR SPIRV_BYTE_COUNT "${SPIRV_HEX_LENGTH} / 2")
math(EXPR SPIRV_WORD_REMAINDER "${SPIRV_BYTE_COUNT} % 4")
if(SPIRV_WORD_REMAINDER)
    message(FATAL_ERROR "The SPIR-V module size must be divisible by four bytes.")
endif()
math(EXPR SPIRV_WORD_COUNT "${SPIRV_BYTE_COUNT} / 4")

string(TOUPPER "${VARIABLE}_H" HEADER_GUARD)
set(HEADER_CONTENT
    "#ifndef ${HEADER_GUARD}\n#define ${HEADER_GUARD}\n\n#include <array>\n#include <cstdint>\n\nnamespace Client::Shaders {\n\ninline constexpr std::array<std::uint32_t, ${SPIRV_WORD_COUNT}> ${VARIABLE}{\n"
)
if(SPIRV_WORD_COUNT GREATER 0)
    math(EXPR LAST_WORD "${SPIRV_WORD_COUNT} - 1")
    foreach(WORD_INDEX RANGE 0 ${LAST_WORD})
        math(EXPR HEX_OFFSET "${WORD_INDEX} * 8")
        string(SUBSTRING "${SPIRV_HEX}" ${HEX_OFFSET} 2 BYTE_0)
        math(EXPR BYTE_1_OFFSET "${HEX_OFFSET} + 2")
        math(EXPR BYTE_2_OFFSET "${HEX_OFFSET} + 4")
        math(EXPR BYTE_3_OFFSET "${HEX_OFFSET} + 6")
        string(SUBSTRING "${SPIRV_HEX}" ${BYTE_1_OFFSET} 2 BYTE_1)
        string(SUBSTRING "${SPIRV_HEX}" ${BYTE_2_OFFSET} 2 BYTE_2)
        string(SUBSTRING "${SPIRV_HEX}" ${BYTE_3_OFFSET} 2 BYTE_3)
        string(APPEND HEADER_CONTENT "    0x${BYTE_3}${BYTE_2}${BYTE_1}${BYTE_0}U,\n")
    endforeach()
endif()
string(APPEND HEADER_CONTENT "};\n\n} // namespace Client::Shaders\n\n#endif // ${HEADER_GUARD}\n")
file(WRITE "${OUTPUT}" "${HEADER_CONTENT}")
